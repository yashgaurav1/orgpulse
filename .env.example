# ==============================================================================
# HAVEN: ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env.local for local development.
# In local development with Firebase Emulators, placeholder values are sufficient.
# For production deployment, replace each [PLACEHOLDER] with values from Firebase Console.

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Firebase Console -> Project Settings -> Web App)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=[FIREBASE_API_KEY]
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=[FIREBASE_PROJECT_ID].firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=[FIREBASE_PROJECT_ID]
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=[FIREBASE_PROJECT_ID].firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=[FIREBASE_MESSAGING_SENDER_ID]
NEXT_PUBLIC_FIREBASE_APP_ID=[FIREBASE_APP_ID]
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=[FIREBASE_MEASUREMENT_ID]

# ------------------------------------------------------------------------------
# 2. Firebase Local Emulator Flags (Set to "true" for local offline testing)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK (Server-Side Only for Cloud Functions & privileged scripts)
# Never expose these credentials to browser code.
# ------------------------------------------------------------------------------
FIREBASE_CLIENT_EMAIL=[FIREBASE_SERVICE_ACCOUNT_EMAIL]
FIREBASE_PRIVATE_KEY=[FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY]

# ------------------------------------------------------------------------------
# 4. Google Gemini AI API Configuration (Cloud Functions Secret ONLY)
# Used exclusively for multi-squad thematic comment summaries (N >= 10, >= 5 comments).
# Must be set as a Cloud Functions Secret: firebase functions:secrets:set GEMINI_API_KEY
# ------------------------------------------------------------------------------
GEMINI_API_KEY=[GEMINI_API_KEY]
GEMINI_MODEL=gemini-1.5-flash
ENABLE_AI_SUMMARY=true

# ------------------------------------------------------------------------------
# 5. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
